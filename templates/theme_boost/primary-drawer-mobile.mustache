{{!
    NWV Theme - Primary Drawer
}}

<div id="theme_boost-drawers-primary" class="drawer d-print-none" data-region="drawer-primary" data-toggle="drawers" data-action="toggle" data-target="theme_boost-drawers-primary" aria-hidden="true">
    <div class="drawer-content">
        <div class="drawer-header d-flex align-items-center justify-content-between pt-2">
            <h6 class="drawer-title m-0 text-truncate" id="theme_boost-drawers-primary-label">
                {{#str}}sitemenu{{/str}}
            </h6>
            <button type="button" class="btn-close ms-auto" data-toggle="drawers" data-action="close" data-target="theme_boost-drawers-primary" aria-controls="theme_boost-drawers-primary" aria-expanded="false" aria-label="{{#str}}closedrawer, core{{/str}}"></button>
        </div>
        {{#primarymoremenu}}
        <div class="primary-navigation">
            {{> core/moremenu }}
        </div>
        {{/primarymoremenu}}
    </div>
</div>

<style>
#theme_boost-drawers-primary {
    margin-top: 102px;
}

.drawer-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    border-bottom: 2px solid #17a2b8;
    padding-bottom: 1rem;
}

.drawer-title {
    color: #0c5460;
    font-weight: 700;
}

.primary-navigation .nav-link {
    color: #0c5460;
    transition: all 0.2s ease;
}

.primary-navigation .nav-link:hover {
    color: #17a2b8;
    background-color: #f8f9fa;
}

.primary-navigation .nav-link.active {
    color: #17a2b8;
    background-color: #e8f4f8;
    border-left: 3px solid #17a2b8;
    padding-left: calc(0.5rem - 3px);
}

@media (max-width: 768px) {
    #theme_boost-drawers-primary {
        margin-top: 100px;
    }
}
</style>
