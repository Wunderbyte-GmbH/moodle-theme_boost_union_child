<div class="container booking-option-agenas">
    <div class="row backgroundrow">
        <!-- Left Column: Image and Overview Box -->
        <div class="col-md-4">
            {{#imageurl}}
            <div class="course-image-wrapper">
                <img class="w-100" src="{{imageurl}}" alt="{{{title}}}">
            </div>
            {{/imageurl}}
            
            <!-- Panoramica corso -->
            <div class="course-overview-box">
                <h4 class="overview-title">{{#str}} courseoverview, theme_boost_union_child {{/str}}</h4>
                
                {{#durata}}
                <div class="overview-item">
                    <div class="overview-label">{{#str}} duration, theme_boost_union_child {{/str}}</div>
                    <div class="overview-value">{{durata}}</div>
                </div>
                {{/durata}}
                
                {{#formato}}
                <div class="overview-item">
                    <div class="overview-label">{{#str}} format, theme_boost_union_child {{/str}}</div>
                    <div class="overview-value">{{formato}}</div>
                </div>
                {{/formato}}
                
                {{#completamento}}
                <div class="overview-item">
                    <div class="overview-label">{{#str}} completion, theme_boost_union_child {{/str}}</div>
                    <div class="overview-value">{{completamento}}</div>
                </div>
                {{/completamento}}
            </div>
        </div>
        
        <!-- Right Column: Content -->
        <div class="col-md-8">
            <h1 class="course-title">{{{title}}}</h1>
            {{#invisible}}
                <div class="booking-option-info-invisible">{{#str}} invisibleoption, mod_booking {{/str}}</div>
            {{/invisible}}
            
            {{#description}}
            <div class="course-description">
                <p>{{{.}}}</p>
            </div>
            {{/description}}
            
            <!-- Cosa imparerai section -->
            {{#learningobjectives}}
            <div class="learning-objectives-section">
                <h3 class="learning-objectives-title">{{#str}} whatyouwilllearn, theme_boost_union_child {{/str}}</h3>
                <div class="learning-objectives-list">
                    {{#objectives}}
                    <div class="learning-objective-item">{{.}}</div>
                    {{/objectives}}
                </div>
            </div>
            {{/learningobjectives}}
            
            {{#statusdescription}}<div class="bo_statusdescription"><p>{{{.}}}</p></div>{{/statusdescription}}
            {{#optionviewcustomfields}}{{{.}}}{{/optionviewcustomfields}}
            {{#attachments}}{{{.}}}{{/attachments}}
            {{> mod_booking/bookingoption_description_teachers }}
            {{> mod_booking/bookingoption_description_dates }}
        </div>
    </div>
    
    <!-- Bottom Navigation -->
    <div class="row mt-4">
        <div class="col-12 p-0 d-flex justify-content-between align-items-center">
            <!-- Back Button -->
            <div>
            {{#returnurl}}
            <a href="{{returnurl}}" role="button" class="btn btn-link back-button">
                <i class="fa-solid fa-arrow-left" style="margin-right: 8px"></i>
                {{#str}} backbutton, theme_boost_union_child {{/str}}
            </a>
            {{/returnurl}}
            </div>
            <div class="ml-auto">
            {{{ bookitsection }}}
            </div>
        </div>
    </div>
</div>

{{#js}}
    require(['local_shopping_cart/cart'], function(cart) {
    cart.buttoninit({{modalcounter}}, "mod_booking");
    });
{{/js}}