{{!
    @template theme_boost/login

    Login page template with quick login role selector.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>"
        }
    }
}}
{{!
    This template extends theme_boost_union/theme_boost/login.

    Modifications:
    * Added Quick Login selector with 3 role circles (Admin, Manager, User)
      above the standard login form for development/demo environments.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid pt-5 mt-0">
        {{> theme_boost_union/infobanners }}
        <div id="page-content" class="row">
            <div id="region-main-box" class="col-12">
                <div id="region-main" class="col-12 h-100">

                {{! ================================================================ }}
                {{! QUICK LOGIN SELECTOR }}
                {{! ================================================================ }}
                <div id="quicklogin-selector" class="mb-4">
                    <p class="quicklogin-hint text-center text-muted mb-3">
                        {{#str}} quickloginhint, theme_boost_union_child {{/str}}
                    </p>
                    <div class="quicklogin-circles d-flex justify-content-center gap-4 flex-wrap">

                        <button type="button"
                                class="quicklogin-circle quicklogin-admin"
                                data-role="admin"
                                aria-label="{{#str}} quickloginadmin, theme_boost_union_child {{/str}}">
                            <span class="quicklogin-icon">
                                <i class="fa fa-user-shield" aria-hidden="true"></i>
                            </span>
                            <span class="quicklogin-label">
                                {{#str}} quickloginadmin, theme_boost_union_child {{/str}}
                            </span>
                        </button>

                        <button type="button"
                                class="quicklogin-circle quicklogin-manager"
                                data-role="manager"
                                aria-label="{{#str}} quickloginmanager, theme_boost_union_child {{/str}}">
                            <span class="quicklogin-icon">
                                <i class="fa fa-user-tie" aria-hidden="true"></i>
                            </span>
                            <span class="quicklogin-label">
                                {{#str}} quickloginmanager, theme_boost_union_child {{/str}}
                            </span>
                        </button>

                        <button type="button"
                                class="quicklogin-circle quicklogin-user"
                                data-role="user"
                                aria-label="{{#str}} quickloginuser, theme_boost_union_child {{/str}}">
                            <span class="quicklogin-icon">
                                <i class="fa fa-user" aria-hidden="true"></i>
                            </span>
                            <span class="quicklogin-label">
                                {{#str}} quickloginuser, theme_boost_union_child {{/str}}
                            </span>
                        </button>

                    </div>
                </div>

                {{! ================================================================ }}
                {{! STANDARD LOGIN FORM }}
                {{! ================================================================ }}
                <div class="login-wrapper {{loginwrapperclass}}">
                    <div class="login-container {{logincontainerclass}}">
                    {{{ output.main_content }}}
                    </div>
                </div>

                </div>
            </div>
        </div>
    </div>
    {{# loginbackgroundimagetext }}
        <div class="container-fluid">
            <div class="row justify-content-end mx-3 my-2" id="loginbackgroundimagetext">
                <span class="small d-none d-md-inline text-{{loginbackgroundimagetextcolor}}">
                    {{loginbackgroundimagetext}}
                </span>
            </div>
        </div>
    {{/ loginbackgroundimagetext }}
    {{> theme_boost/footer }}
    {{> theme_boost_union/footnote }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});

// Quick Login: submit a POST form when a role circle is clicked.
(function() {
    var circles = document.querySelectorAll('.quicklogin-circle');
    circles.forEach(function(circle) {
        circle.addEventListener('click', function() {
            var role = this.getAttribute('data-role');
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = M.cfg.wwwroot + '/theme/boost_union_child/quicklogin.php';

            var roleInput = document.createElement('input');
            roleInput.type = 'hidden';
            roleInput.name = 'role';
            roleInput.value = role;
            form.appendChild(roleInput);

            var sesskeyInput = document.createElement('input');
            sesskeyInput.type = 'hidden';
            sesskeyInput.name = 'sesskey';
            sesskeyInput.value = M.cfg.sesskey;
            form.appendChild(sesskeyInput);

            document.body.appendChild(form);
            form.submit();
        });
    });
})();
{{/js}}
