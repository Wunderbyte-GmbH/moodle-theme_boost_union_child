{{!
    Praxisbörse single entry view template.
    
    Displays a single Praxisbörse entry with full details.
    
    @package   theme_nwverkehrserziehung
    @copyright 2024
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}

<div class="praxisboerse-entry-container container my-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h1 class="mb-0">{{{title}}}</h1>
                </div>
                <div class="card-body">
                    <div class="praxisboerse-entry-content">
                        {{#image}}
                        <div class="praxisboerse-entry-image mb-4">
                            {{{image}}}
                        </div>
                        {{/image}}
                        
                        {{#description_fields}}
                        {{#value}}
                        <div class="entry-field mb-4">
                            <h5 class="field-name text-primary">{{name}}</h5>
                            <div class="field-content">
                                {{{value}}}
                            </div>
                        </div>
                        {{/value}}
                        {{/description_fields}}
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    <div class="row">
                        <div class="col-md-6">
                            <i class="fa fa-user"></i> {{username}}
                        </div>
                        <div class="col-md-6 text-end">
                            <i class="fa fa-calendar"></i> {{timecreated}}
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.praxisboerse-entry-container {
    padding: 30px 0;
}

.praxisboerse-entry-image {
    max-width: 600px;
    margin: 0 auto;
}

.praxisboerse-entry-image img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
}

.entry-field {
    padding: 20px;
    background-color: #f8f9fa;
    border-left: 4px solid #b5001f;
    border-radius: 4px;
}

.field-name {
    margin-bottom: 10px;
    font-weight: 600;
}

.field-content {
    line-height: 1.6;
    color: #333;
}

.field-content img {
    max-width: 100%;
    height: auto;
    margin: 10px 0;
}

.card-header h1 {
    font-size: 1.8rem;
    font-weight: 600;
}

@media (max-width: 768px) {
    .praxisboerse-entry-image {
        max-width: 100%;
    }
    
    .card-header h1 {
        font-size: 1.3rem;
    }
    
    .entry-field {
        padding: 15px;
    }
}
</style>
