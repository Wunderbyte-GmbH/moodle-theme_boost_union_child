{{#courses}}
{{#hascourselink}}
<a href="{{courselink}}" style="text-decoration:none;">
<div class="card border  pl-0 pr-3 pt-0 pb-0 sk-fade ml-0 mr-0 mb-3">
  <div class="row g-0 align-items-stretch">
    <div class="col-md-3 img-container">
    <img src="{{courseimage}}" class="chorizontal rounded-start" alt="{{coursename}}">
    </div>
    <div class="col-md-9 h-100">
      <div class="card-body agenas">
        <div class="d-flex flex-column  p-2" style="height: 220px;">
          <div class="mb-2">
              {{#category}}<div class="cardcompetency ml-0">
                  <span class="cardcompetencytag mb-2">{{category}}</span>
              </div>
              {{/category}}
              </div>
          <div class="card-title fw-bold mb-3 h5 text">
            {{coursename}}
          </div>
          <div class="text-muted small d-flex align-items-center gap-2 mt-auto">
          {{#duration}}
          <span>
            <i class="far fa-clock fa-fw"></i>
            {{duration}}
          </span>
          {{/duration}}

          {{#hasprogress}}
          <span class="mx-2"> | </span>
          <span> {{progresstext}}</span>
          {{/hasprogress}}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

</a>
{{/hascourselink}}
{{/courses}}

<style>
.img-container{
    overflow:hidden;
}
.img-container{
    height: 220px;
}

.chorizontal{
    width: 100%;
    height: 100%;
    object-fit: cover;
}
</style>