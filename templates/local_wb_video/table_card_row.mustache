{{!
    @template local_wunderbyte_table/table
    Template which defines a mooduell view page.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * statistics - array: An array with values.
    * opengames - array: empty array, will be filled with JS.
    * finishedgames - array: empty array, will be filled with JS.
    * highscores - array: empty array, will be filled with JS.

    Example context (json):
    {
       "listheaderclass" : "listheaderclass",
       "cardheaderclass" : "cardheaderclass",
       "cardfooterclass" : "cardfooterclass",
       "cardimageclass" : "cardimageclass",
       "cardheader": [
          {
            "columnclass" : "columnclass",
            "columnkeyclass" : "columnkeyclass",
            "key" : "columnname",
            "keystring" : "localized column name",
            "columnvalueclass" : "columnvalueclass",
            "value" : "value"
          }
       ],
       "cardbody": [
          {
            "columnclass" : "columnclass",
            "columnkeyclass" : "columnkeyclass",
            "key" : "columnname",
            "keystring" : "localized column name",
            "columnvalueclass" : "columnvalueclass",
            "value" : "value"
          }
       ],
       "cardfooter": [
          {
            "columnclass" : "columnclass",
            "columnkeyclass" : "columnkeyclass",
            "key" : "columnname",
            "keystring" : "localized column name",
            "columnvalueclass" : "columnvalueclass",
            "value" : "value"
          }
       ],
       "cardimage": [
          {
            "value" : "value"
          }
       ]
    }
}}
<div class="col-md-4 my-4 align-items-stretch">
   <div class="card video-card mb-2 search-data-element  h-100"
      {{#datafields}}
        data-{{key}}="{{value}}"
      {{/datafields}}
      >

      <div class="card-body bg-white rr-16">
         <div class="d-flex flex-column justify-content-between">
         {{#videosrc}}
         {{{value}}}
         {{/videosrc}}
         {{#pillfields}}
         <span class="pill badge bg-success text-white my-2 p-2">{{value}}</span>
         {{/pillfields}}
         {{#tags}}
            {{{value}}}
         {{/tags}}
            <div>
               {{#action}}
                  {{{value}}}
               {{/action}}
            </div>
            {{#cname}}
            <h3 class="mt-2">{{value}}</h3>
            {{/cname}}
            {{#timecreated}}
               <div class="d-flex row mt-4">
                  <div class="col-md-12 text-left small"><b>{{{value}}}</b></div>
               </div>
               {{/timecreated}}
            {{#summary}}
               {{{value}}}
            {{/summary}}
         </div>
         </div>
      
   </div>
  </div>
