<div class="card mb-3 border-0" style="">
    <div class="row g-0 align-items-center">
        <div class="col-md-4">
        <img src="{{image}}" class="img-fluid rounded-start" alt="{{title}}">
        </div>
        <div class="col-md-8">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-1">
            <span class="text-muted small fw-semibold">{{category}}</span>
            <span class="text-muted small">{{date}}</span>
            </div>
            <h5 class="card-title fw-bold text-primary mb-2">{{title}}</h5>
            <p class="card-text mb-0">{{text}}</p>
        </div>
        </div>
    </div>
</div>
