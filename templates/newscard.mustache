<div class="card mb-3 border-0">
    <div class="row g-0 align-items-center">
        <div class="col-md-4">
            <img src="{{bgimage}}" class="img-fluid rounded-start" alt="{{headline}}">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    {{#category}}
                    <span class="text-muted small fw-semibold">{{category}}</span>
                    {{/category}}
                    {{#date}}
                    <span class="text-muted small">{{date}}</span>
                    {{/date}}
                </div>
                <h6 class="fw-bold mb-2">{{subheadline}}</h5>
                <h5 class="card-title fw-bold text-primary mb-2">{{headline}}</h5>
                <p class="card-text mb-0">{{{description}}}</p>
            </div>
        </div>
    </div>
</div>
