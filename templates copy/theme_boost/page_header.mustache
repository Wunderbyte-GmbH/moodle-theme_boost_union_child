{{!
    NWV Theme - Page header
}}
<div id="nwv-page-header" class="nwv-theme-header bg-light py-4 mb-4 border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-auto">
                {{#page_icon}}
                <div class="nwv-page-icon me-3">
                    {{{page_icon}}}
                </div>
                {{/page_icon}}
            </div>
            <div class="col">
                <h1 class="nwv-page-title mb-1">{{page_title}}</h1>
                {{#page_subtitle}}
                <p class="text-muted mb-0">{{page_subtitle}}</p>
                {{/page_subtitle}}
            </div>
            {{#breadcrumbs}}
            <div class="col-12">
                <nav aria-label="breadcrumb" class="mt-2">
                    <ol class="breadcrumb mb-0 small">
                        {{#items}}
                        <li class="breadcrumb-item{{#active}} active{{/active}}">
                            {{#url}}<a href="{{url}}">{{/url}}
                            {{text}}
                            {{#url}}</a>{{/url}}
                        </li>
                        {{/items}}
                    </ol>
                </nav>
            </div>
            {{/breadcrumbs}}
        </div>
    </div>
</div>

<style>
#nwv-page-header {
    background: linear-gradient(to right, #f8f9fa 0%, #ffffff 100%);
    border-bottom: 2px solid #17a2b8;
}

.nwv-page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #0c5460;
    margin: 0;
}

.nwv-page-icon {
    font-size: 2.5rem;
    color: #17a2b8;
}

.breadcrumb {
    background-color: transparent;
    padding: 0;
}

.breadcrumb-item + .breadcrumb-item::before {
    color: #0c5460;
}

.breadcrumb-item a {
    color: #0c5460;
    text-decoration: none;
}

.breadcrumb-item a:hover {
    color: #17a2b8;
    text-decoration: underline;
}

.breadcrumb-item.active {
    color: #6c757d;
}

@media (max-width: 768px) {
    .nwv-page-title {
        font-size: 1.5rem;
    }
    
    .nwv-page-icon {
        display: none;
    }
}
</style>
